{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox2",
  "version": "0.4.11",
  "identifier": "com.chris.translator",
  "build": {
    "frontendDist": "../resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vox2",
        "width": 420,
        "height": 580,
        "minWidth": 300,
        "minHeight": 340,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net",
        "worker-src": "'self' blob: https://cdn.jsdelivr.net",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://cdn.jsdelivr.net https://huggingface.co https://*.hf.co https://clients5.google.com https://translate.googleapis.com https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: mediastream:",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBENEFCQUI2MTExREJCQjMKUldTenV4MFJ0cnBLRFpDZUpQeU1DcG5JK1BZWFRoaTlkMGpoZHdOYVZ3ODNSTGttZExVdlI0SkIK",
      "endpoints": ["https://github.com/chrisqtruong/vox2/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
