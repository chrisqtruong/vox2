{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox2",
  "version": "0.4.5",
  "identifier": "com.chris.translator",
  "build": {
    "frontendDist": "../resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vox2",
        "width": 420,
        "height": 580,
        "minWidth": 300,
        "minHeight": 340,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBENEFCQUI2MTExREJCQjMKUldTenV4MFJ0cnBLRFpDZUpQeU1DcG5JK1BZWFRoaTlkMGpoZHdOYVZ3ODNSTGttZExVdlI0SkIK",
      "endpoints": ["https://github.com/chrisqtruong/vox2/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
